import { apiClient } from '@/lib/api-client';
import type { Resource } from '@/features/resources/api/resources.api';

// ============================================================
// TYPES
// ============================================================
export interface SearchParams {
  q?: string;
  type?: 'file' | 'link' | 'note';
  mimeType?: string;
  folderId?: string;
  createdBy?: string;
  dateFrom?: string;
  dateTo?: string;
  sizeMin?: number;
  sizeMax?: number;
  page?: number;
  limit?: number;
  sortBy?: 'name' | 'created_at' | 'size_bytes' | 'updated_at';
  order?: 'asc' | 'desc';
}

export interface AdvancedSearchParams {
  query?: string;
  filters?: {
    types?: Array<'file' | 'link' | 'note'>;
    mimeTypes?: string[];
    folderIds?: string[];
    createdBy?: string[];
    dateRange?: {
      from?: string;
      to?: string;
    };
    sizeRange?: {
      min?: number;
      max?: number;
    };
  };
  page?: number;
  limit?: number;
}

export interface SearchResponse {
  success: boolean;
  data: Resource[];
  pagination: {
    page: number;
    limit: number;
    total: number;
    totalPages: number;
  };
}

export interface SearchSuggestion {
  id: string;
  name: string;
  type: string;
  mime_type: string | null;
  folder_name: string | null;
}

// ============================================================
// API FUNCTIONS
// ============================================================
export const searchApi = {
  /**
   * Tìm kiếm cơ bản (query string)
   */
  search: async (params: SearchParams): Promise<SearchResponse> => {
    const { data } = await apiClient.get('/search', { params });
    return data;
  },

  /**
   * Tìm kiếm nâng cao (nhiều filters)
   */
  advancedSearch: async (params: AdvancedSearchParams): Promise<SearchResponse> => {
    const { data } = await apiClient.post('/search/advanced', params);
    return data;
  },

  /**
   * Gợi ý từ khóa (autocomplete)
   */
  getSuggestions: async (q: string): Promise<string[]> => {
    const { data } = await apiClient.get('/search/suggestions', { params: { q } });
    return data.data;
  },

  /**
   * Tài nguyên truy cập gần đây
   */
  getRecent: async (limit: number = 10): Promise<SearchSuggestion[]> => {
    const { data } = await apiClient.get('/search/recent', { params: { limit } });
    return data.data;
  },
};
</file>

<file path="src/features/search/components/global-search-bar.tsx">
import { useState, useEffect, useRef } from 'react';
import { useNavigate } from 'react-router-dom';
import { Search, X, FileText, Loader2 } from 'lucide-react';
import { Input } from '@/components/ui/input';
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from '@/components/ui/popover';
import { useDebounce } from '@/hooks/use-debounce';
import { useSearchSuggestions, useRecentResources } from '../hooks/use-search';

export function GlobalSearchBar() {
  const navigate = useNavigate();
  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState('');
  const debouncedQuery = useDebounce(query, 300);
  const inputRef = useRef<HTMLInputElement>(null);

  const { data: suggestions = [], isLoading } = useSearchSuggestions(debouncedQuery);
  const { data: recent = [] } = useRecentResources(5);

  // Đóng popover khi query rỗng
  useEffect(() => {
    if (!query) {
      setOpen(false);
    }
  }, [query]);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (query.trim()) {
      navigate(`/search?q=${encodeURIComponent(query.trim())}`);
      setOpen(false);
      setQuery('');
    }
  };

  const handleSuggestionClick = (suggestion: string) => {
    navigate(`/search?q=${encodeURIComponent(suggestion)}`);
    setOpen(false);
    setQuery('');
  };

  const handleRecentClick = (item: any) => {
    navigate(`/search?q=${encodeURIComponent(item.name)}`);
    setOpen(false);
    setQuery('');
  };

  return (
    <Popover open={open} onOpenChange={setOpen}>
      <PopoverTrigger asChild>
        <form onSubmit={handleSubmit} className="relative hidden md:block">
          <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
          <Input
            ref={inputRef}
            placeholder="Tìm kiếm tài nguyên..."
            className="w-64 pl-10 pr-10 lg:w-96"
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setOpen(true);
            }}
            onFocus={() => {
              if (query || recent.length > 0) setOpen(true);
            }}
          />
          {query && (
            <button
              type="button"
              onClick={() => {
                setQuery('');
                setOpen(false);
                inputRef.current?.focus();
              }}
              className="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground"
            >
              <X className="h-4 w-4" />
            </button>
          )}
        </form>
      </PopoverTrigger>

      <PopoverContent
        className="w-[400px] p-0"
        align="start"
        onOpenAutoFocus={(e) => e.preventDefault()}
      >
        {isLoading ? (
          <div className="flex items-center justify-center p-6">
            <Loader2 className="h-5 w-5 animate-spin text-muted-foreground" />
          </div>
        ) : suggestions.length > 0 ? (
          <div className="p-2">
            <div className="px-2 py-1.5 text-xs font-semibold text-muted-foreground">
              Gợi ý
            </div>
            {suggestions.map((suggestion, idx) => (
              <button
                key={idx}
                onClick={() => handleSuggestionClick(suggestion)}
                className="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-accent"
              >
                <Search className="h-3.5 w-3.5 text-muted-foreground" />
                <span className="truncate">{suggestion}</span>
              </button>
            ))}
          </div>
        ) : recent.length > 0 && !query ? (
          <div className="p-2">
            <div className="px-2 py-1.5 text-xs font-semibold text-muted-foreground">
              Truy cập gần đây
            </div>
            {recent.map((item) => (
              <button
                key={item.id}
                onClick={() => handleRecentClick(item)}
                className="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-accent"
              >
                <FileText className="h-3.5 w-3.5 text-muted-foreground" />
                <span className="truncate flex-1 text-left">{item.name}</span>
                {item.folder_name && (
                  <span className="text-xs text-muted-foreground truncate max-w-[100px]">
                    {item.folder_name}
                  </span>
                )}
              </button>
            ))}
          </div>
        ) : (
          <div className="p-6 text-center text-sm text-muted-foreground">
            Nhập ít nhất 2 ký tự để tìm kiếm
          </div>
        )}
      </PopoverContent>
    </Popover>
  );
}
</file>

<file path="src/features/search/components/recent-searches.tsx">
import { useState, useEffect } from 'react';
import { Clock, X, Search } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { useLocalStorage } from '@/hooks/use-local-storage';

const STORAGE_KEY = 'crms-recent-searches';
const MAX_ITEMS = 10;

interface RecentSearchesProps {
  onSelect: (query: string) => void;
}

export function RecentSearches({ onSelect }: RecentSearchesProps) {
  const [searches, setSearches] = useLocalStorage<string[]>(STORAGE_KEY, []);

  const addSearch = (query: string) => {
    const trimmed = query.trim();
    if (!trimmed) return;

    setSearches((prev) => {
      const filtered = prev.filter((s) => s !== trimmed);
      return [trimmed, ...filtered].slice(0, MAX_ITEMS);
    });
  };

  const removeSearch = (query: string) => {
    setSearches((prev) => prev.filter((s) => s !== query));
  };

  const clearAll = () => {
    setSearches([]);
  };

  if (searches.length === 0) return null;

  return (
    <div className="border rounded-lg p-4">
      <div className="flex items-center justify-between mb-3">
        <h3 className="text-sm font-semibold flex items-center gap-1.5">
          <Clock className="h-4 w-4" />
          Tìm kiếm gần đây
        </h3>
        <Button variant="ghost" size="sm" className="h-7 text-xs" onClick={clearAll}>
          Xóa tất cả
        </Button>
      </div>
      <div className="flex flex-wrap gap-2">
        {searches.map((search) => (
          <div
            key={search}
            className="group flex items-center gap-1 bg-secondary rounded-md px-2 py-1 text-xs"
          >
            <button
              onClick={() => onSelect(search)}
              className="flex items-center gap-1 hover:text-primary"
            >
              <Search className="h-3 w-3" />
              {search}
            </button>
            <button
              onClick={() => removeSearch(search)}
              className="opacity-0 group-hover:opacity-100 hover:text-destructive transition-opacity"
            >
              <X className="h-3 w-3" />
            </button>
          </div>
        ))}
      </div>
    </div>
  );
}

// Export helper để các component khác có thể lưu search
export function useSaveRecentSearch() {
  const [searches, setSearches] = useLocalStorage<string[]>(STORAGE_KEY, []);

  return (query: string) => {
    const trimmed = query.trim();
    if (!trimmed) return;
    setSearches((prev) => {
      const filtered = prev.filter((s) => s !== trimmed);
      return [trimmed, ...filtered].slice(0, MAX_ITEMS);
    });
  };
}
