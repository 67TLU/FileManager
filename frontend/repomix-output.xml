                borderRadius: '6px',
              }}
              formatter={(value: number) => [formatFileSize(value), 'Dung lượng']}
            />
            <Area
              type="monotone"
              dataKey="bytes"
              stroke="#3b82f6"
              fillOpacity={1}
              fill="url(#colorBytes)"
            />
          </AreaChart>
        </ResponsiveContainer>
      </CardContent>
    </Card>
  );
