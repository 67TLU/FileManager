import * as React from 'react';
import {
  Controller, FormProvider, useFormContext,
  type ControllerProps, type FieldPath, type FieldValues,
} from 'react-hook-form';
import { cn } from '@/lib/utils';

const Form = FormProvider;

type FieldCtx = { name: string; id: string; error?: string };
const FieldContext = React.createContext<FieldCtx | null>(null);
const useField = () => {
  const c = React.useContext(FieldContext);
  if (!c) throw new Error('FormField must be used inside <FormField>');
  return c;
};

function FormField<T extends FieldValues, N extends FieldPath<T>>(
  props: ControllerProps<T, N>
) {
  const id = React.useId();
  return (
    <Controller
      {...props}
      render={(state) => (
        <FieldContext.Provider
          value={{ name: String(props.name), id, error: state.fieldState.error?.message }}
        >
          <div className="space-y-2">{props.render(state) as React.ReactNode}</div>
        </FieldContext.Provider>
      )}
    />
  );
}

function FormItem({ className, ...p }: React.ComponentProps<'div'>) {
  return <div className={cn('space-y-2', className)} {...p} />;
}

function FormLabel({ className, ...p }: React.ComponentProps<'label'>) {
  const { id, error } = useField();
  return (
    <label htmlFor={id}
      className={cn('text-sm font-medium', error && 'text-destructive', className)}
      {...p} />
  );
}

/** Clone child để gắn id + aria (thay cho Radix Slot) */
function FormControl({ children }: { children: React.ReactElement }) {
  const { id, error } = useField();
  return React.cloneElement(children as any, {
    id,
    'aria-invalid': !!error,
    'aria-describedby': error ? `${id}-msg` : undefined,
  });
}

function FormDescription({ className, ...p }: React.ComponentProps<'p'>) {
  const { id } = useField();
  return <p id={`${id}-desc`} className={cn('text-sm text-muted-foreground', className)} {...p} />;
}

function FormMessage({ className, children, ...p }: React.ComponentProps<'p'>) {
  const { id, error } = useField();
  const body = children ?? error;
  if (!body) return null;
  return (
    <p id={`${id}-msg`} className={cn('text-sm font-medium text-destructive', className)} {...p}>
      {body}
    </p>
  );
}

export { Form, FormField, FormItem, FormLabel, FormControl, FormDescription, FormMessage, useField, useFormContext };
</file>

