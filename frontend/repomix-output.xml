<file path="src/features/resources/api/resources.api.ts">
import { apiClient } from '@/lib/api-client';

export interface Resource {
  id: string;
  name: string;
  type: 'file' | 'link' | 'note';
  mime_type: string | null;
  size_bytes: number;
  status: 'active' | 'trashed' | 'deleted';
  created_at: string;
  updated_at?: string;
  trashed_at: string | null;      // ← thiếu trước đây
  folder_id?: string;
  folder_name?: string;
  created_by_name: string | null;
  last_accessed?: string;
}

export interface ResourceVersion {
  id: string; version_number: number; original_name: string;
  size_bytes: number; mime_type: string; created_at: string;
  created_by_name: string | null;
}

export interface ResourceDetail extends Resource {
  folder_name: string; workspace_id: string; versions: ResourceVersion[];
}

export interface FolderNode {
  id: string; name: string; parent_id: string | null;
  path: string; depth: number; children: FolderNode[];
}

export interface FolderTreeResponse {
  workspace: { id: string; name: string; type: string };
  tree: FolderNode[]; total: number;
}

export interface ListResourcesResponse {
  success: boolean;
  data: Resource[];
  pagination: { page: number; limit: number; total: number; totalPages: number };
}

export const resourcesApi = {
  list: async (params: {
    folderId: string; page?: number; limit?: number;
    sortBy?: 'name' | 'created_at' | 'size_bytes'; order?: 'asc' | 'desc';
  }): Promise<ListResourcesResponse> => {
    const { data } = await apiClient.get('/resources', { params });
    return data;
  },

  getDetail: async (id: string): Promise<ResourceDetail> => {
    const { data } = await apiClient.get(`/resources/${id}`);
    return data.data;
  },

  upload: async (file: File, folderId: string, onProgress?: (p: number) => void) => {
    const fd = new FormData();
    fd.append('file', file);
    fd.append('folderId', folderId);
    const { data } = await apiClient.post('/resources/upload', fd, {
      headers: { 'Content-Type': 'multipart/form-data' },
      onUploadProgress: (e) => {
        if (onProgress && e.total) onProgress(Math.round((e.loaded * 100) / e.total));
      },
    });
    return data;
  },

  download: async (id: string, fileName: string) => {
    const res = await apiClient.get(`/resources/${id}/download`, { responseType: 'blob' });
    const url = window.URL.createObjectURL(new Blob([res.data]));
    const a = document.createElement('a');
    a.href = url; a.download = fileName;
    document.body.appendChild(a); a.click(); a.remove();
    window.URL.revokeObjectURL(url);
  },

  moveToTrash: async (id: string) => { await apiClient.post(`/resources/${id}/trash`); },
  restore: async (id: string) => { await apiClient.post(`/resources/${id}/restore`); },
  permanentDelete: async (id: string) => { await apiClient.delete(`/resources/${id}/permanent`); },
  permanentDeleteMany: async (ids: string[]) => {
    for (const id of ids) await apiClient.delete(`/resources/${id}/permanent`);
  },
  listTrash: async (): Promise<Resource[]> => {
    const { data } = await apiClient.get('/resources/trash');
    return data.data;
  },
};

export const foldersApi = {
  getTree: async (workspaceId: string): Promise<FolderTreeResponse> => {
    const { data } = await apiClient.get(`/workspaces/${workspaceId}/folders`);
    return data.data;
  },
  create: async (p: { workspaceId: string; parentId: string | null; name: string }): Promise<FolderNode> => {
    const { data } = await apiClient.post('/folders', p);
    return data.data;
  },
};
</file>

<file path="src/features/resources/components/create-folder-dialog.tsx">
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import { Loader2 } from 'lucide-react';
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
  DialogFooter,
} from '@/components/ui/dialog';
import { Button } from '@/components/ui/button';
import {
  Form,
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from '@/components/ui/form';
import { Input } from '@/components/ui/input';
import { useCreateFolder } from '../hooks/use-resources';

const COMPANY_WORKSPACE_ID = 'd0000000-0000-4000-8000-000000000001';

const formSchema = z.object({
  name: z
    .string()
    .min(1, 'Tên thư mục không được để trống')
    .max(255, 'Tên tối đa 255 ký tự')
    .regex(/^[^/\\]+$/, 'Tên không được chứa / hoặc \\'),
});

type FormValues = z.infer<typeof formSchema>;

interface CreateFolderDialogProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  parentId: string | null;
}

export function CreateFolderDialog({
  open,
  onOpenChange,
  parentId,
}: CreateFolderDialogProps) {
  const createFolderMutation = useCreateFolder();

  const form = useForm<FormValues>({
    resolver: zodResolver(formSchema),
    defaultValues: { name: '' },
  });

  const onSubmit = async (data: FormValues) => {
    try {
      await createFolderMutation.mutateAsync({
        workspaceId: COMPANY_WORKSPACE_ID,
        parentId,
        name: data.name.trim(),
      });
      form.reset();
      onOpenChange(false);
    } catch {
      // Error đã được xử lý trong mutation
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>Tạo thư mục mới</DialogTitle>
          <DialogDescription>
            Nhập tên cho thư mục mới
          </DialogDescription>
        </DialogHeader>

        <Form {...form}>
          <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4">
            <FormField
              control={form.control}
              name="name"
              render={({ field }) => (
                <FormItem>
                  <FormLabel>Tên thư mục</FormLabel>
                  <FormControl>
                    <Input placeholder="Ví dụ: Tài liệu dự án" autoFocus {...field} />
                  </FormControl>
                  <FormMessage />
                </FormItem>
              )}
            />

            <DialogFooter>
              <Button
                type="button"
                variant="outline"
                onClick={() => onOpenChange(false)}
              >
                Hủy
              </Button>
              <Button type="submit" disabled={createFolderMutation.isPending}>
                {createFolderMutation.isPending ? (
                  <>
                    <Loader2 className="h-4 w-4 mr-2 animate-spin" />
                    Đang tạo...
                  </>
                ) : (
                  'Tạo thư mục'
                )}
              </Button>
            </DialogFooter>
          </form>
        </Form>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/features/resources/components/folder-tree.tsx">
import { ChevronRight, ChevronDown, Folder, FolderOpen } from 'lucide-react';
import { useState } from 'react';
import { cn } from '@/lib/utils';
import { Button } from '@/components/ui/button';
import { ScrollArea } from '@/components/ui/scroll-area';
import { Skeleton } from '@/components/ui/skeleton';
import {
  Collapsible,
  CollapsibleContent,
  CollapsibleTrigger,
} from '@/components/ui/collapsible';
import { useFolderTree } from '../hooks/use-folder-tree';
import type { FolderNode } from '../api/resources.api';

interface FolderTreeProps {
  selectedFolderId: string | null;
  onSelectFolder: (folderId: string) => void;
}

export function FolderTree({ selectedFolderId, onSelectFolder }: FolderTreeProps) {
  const { data, isLoading, error } = useFolderTree();

  if (isLoading) {
    return (
      <div className="space-y-2 p-4">
        <Skeleton className="h-8 w-full" />
        <Skeleton className="h-8 w-3/4" />
        <Skeleton className="h-8 w-1/2" />
      </div>
    );
  }

  if (error) {
    return (
      <div className="p-4 text-sm text-destructive">
        Không thể tải cây thư mục
      </div>
    );
  }

  if (!data?.tree.length) {
    return (
      <div className="p-4 text-sm text-muted-foreground">
        Chưa có thư mục nào
      </div>
    );
  }

  return (
    <ScrollArea className="h-full">
      <div className="py-2">
        {data.tree.map((node) => (
          <FolderTreeItem
            key={node.id}
            node={node}
            level={0}
            selectedFolderId={selectedFolderId}
            onSelectFolder={onSelectFolder}
          />
        ))}
      </div>
    </ScrollArea>
  );
}

interface FolderTreeItemProps {
  node: FolderNode;
  level: number;
  selectedFolderId: string | null;
  onSelectFolder: (folderId: string) => void;
}

function FolderTreeItem({
  node,
  level,
  selectedFolderId,
  onSelectFolder,
}: FolderTreeItemProps) {
  const [isOpen, setIsOpen] = useState(false);
  const hasChildren = node.children.length > 0;
  const isSelected = selectedFolderId === node.id;

  return (
    <Collapsible open={isOpen} onOpenChange={setIsOpen}>
      <div
        className={cn(
          'flex items-center gap-1 rounded-md px-2 py-1.5 text-sm cursor-pointer hover:bg-accent',
          isSelected && 'bg-accent font-medium'
        )}
        style={{ paddingLeft: `${level * 16 + 8}px` }}
        onClick={() => onSelectFolder(node.id)}
      >
        {hasChildren ? (
          <CollapsibleTrigger asChild>
            <Button
              variant="ghost"
              size="icon"
              className="h-5 w-5 p-0"
              onClick={(e) => {
                e.stopPropagation();
                setIsOpen(!isOpen);
              }}
            >
              {isOpen ? (
                <ChevronDown className="h-4 w-4" />
              ) : (
                <ChevronRight className="h-4 w-4" />
              )}
            </Button>
          </CollapsibleTrigger>
        ) : (
          <div className="w-5" />
        )}

        {isOpen ? (
          <FolderOpen className="h-4 w-4 text-amber-500 shrink-0" />
        ) : (
          <Folder className="h-4 w-4 text-amber-500 shrink-0" />
        )}

        <span className="truncate flex-1">{node.name}</span>
      </div>

      {hasChildren && (
        <CollapsibleContent>
          {node.children.map((child) => (
            <FolderTreeItem
              key={child.id}
              node={child}
              level={level + 1}
              selectedFolderId={selectedFolderId}
              onSelectFolder={onSelectFolder}
            />
          ))}
        </CollapsibleContent>
      )}
    </Collapsible>
  );
}
</file>

