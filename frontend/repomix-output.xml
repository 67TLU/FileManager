function getInitials(name: string): string {
  return name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}

export function UserDetailDialog({ user, open, onOpenChange }: UserDetailDialogProps) {
