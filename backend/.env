PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sudo1234@
DB_NAME=postgres
DATABASE_URL="postgresql://postgres:sudo1234%40@localhost:5432/crms"
# JWT
JWT_ACCESS_SECRET=super_secret_access_key_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_URL=/files