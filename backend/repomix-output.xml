      await transporter.sendMail({
        from: `"ACME Corp" <${env.SMTP_USER}>`,
        to: email,
        subject: `Bạn được mời tham gia ACME Corp`,
        html: `
          <h2>Lời mời tham gia hệ thống</h2>
